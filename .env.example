# Public URL of the site (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://baseoffice.example.com

# Where the release files are hosted. Placeholders: {product}, {version}, {file}.
# Default (unset): files in public/files/, served at /files/{file}
# GitHub Releases example:
# DOWNLOAD_URL_TEMPLATE=https://github.com/OWNER/REPO/releases/download/v{version}/{file}
